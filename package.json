{
  "name": "scheduler",
  "version": "0.2.0",
  "private": true,
  "bin": {
    "scheduler": "scripts/scheduler.mjs",
    "scheduler-mcp": "scripts/scheduler-mcp.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "scheduler": "node scripts/scheduler.mjs",
    "mcp": "node scripts/scheduler-mcp.mjs",
    "test:mcp": "vitest run tests/scheduler-mcp.test.ts",
    "test:control": "vitest run tests/apps-script-control.test.ts tests/apps-script-atomic.test.ts tests/scheduler-cli.test.ts",
    "dev": "vite",
    "build": "npm run icons:check && vite build && node scripts/verify-pwa-build.mjs",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "icons:check": "node scripts/generate-pwa-icons.mjs --check",
    "test:pwa": "vitest run tests/pwa-client.test.ts tests/pwa-ui.test.tsx",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:contracts": "vitest run tests/api-contract.test.ts tests/api-version.test.ts",
    "test:cache": "vitest run tests/apps-script-cache.test.ts",
    "test:migrations": "vitest run tests/apps-script-migrations.test.ts && node scripts/test-apps-script-schema.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "playwright show-report",
    "test:calendar": "vitest run tests/calendar.test.ts tests/calendar-flow.test.tsx",
    "test": "vitest run && node scripts/test-apps-script-import.mjs && node scripts/test-apps-script-preferences.mjs && node scripts/test-apps-script-schema.mjs && node scripts/test-apps-script-history.mjs && node scripts/test-apps-script-undo.mjs && node scripts/test-apps-script-semesters.mjs && node scripts/test-apps-script-admin.mjs",
    "apps-script:bundle": "node scripts/bundle-apps-script.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run apps-script:bundle"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "ical.js": "2.2.1",
    "jsdom": "^29.1.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
