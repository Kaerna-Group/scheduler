{
  "name": "scheduler",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:contracts": "vitest run tests/api-contract.test.ts tests/api-version.test.ts",
    "test:cache": "vitest run tests/apps-script-cache.test.ts",
    "test": "vitest run && node scripts/test-apps-script-import.mjs && node scripts/test-apps-script-preferences.mjs && node scripts/test-apps-script-schema.mjs && node scripts/test-apps-script-history.mjs && node scripts/test-apps-script-undo.mjs && node scripts/test-apps-script-semesters.mjs && node scripts/test-apps-script-admin.mjs",
    "apps-script:bundle": "node scripts/bundle-apps-script.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run apps-script:bundle"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "^29.1.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
